# Copy this file to .env, replace every placeholder, and load it with:
# set -a; source .env; set +a
#
# .env is ignored by Git. Never commit clinical manifests, local filesystem
# paths, credentials, or model checkpoints.

export DEEPMS_PROJECT_ROOT=/path/to/DeepMS
export DEEPMS_UV_BIN=/path/to/uv

export DEEPMS_TRAIN_CSV=/path/to/train_images.csv
export DEEPMS_VAL_CSV=/path/to/validation_images.csv
export DEEPMS_PRETRAINED_PATH=/path/to/VoComni_B.pt

export DEEPMS_MODEL_PATH=/path/to/best_model.pth
export DEEPMS_INTERNAL_TEST_CSV=/path/to/internal_test_images.csv
export DEEPMS_KRAKOW_TEST_CSV=/path/to/krakow_test_images.csv
export DEEPMS_PUBLIC_EXTERNAL_TEST_CSV=/path/to/public_external_images_with_optional_masked_path.csv
export DEEPMS_REPORT_BOOTSTRAPS=2000

# One-command single-map pipeline: train once, run Public External unmasked
# and masked inference, then produce calibrated-dataset and raw-masking reports.
export DEEPMS_PIPELINE_MODE=both
export DEEPMS_ABLATION_INFER_PROFILE=public_external_unmasked
export DEEPMS_ABLATION_EVAL_ID=replace-with-a-unique-evaluation-id
export DEEPMS_ABLATION_CONCURRENCY=4
export DEEPMS_INCLUDE_B0=1
export DEEPMS_SAVE_VISUALIZATIONS=0

# Submit from the repository root after loading this file:
# sbatch scripts/slurm/ablation/run_diffusion_ablation_pipeline.sbatch

# The pipeline creates an evaluation-specific training root automatically.
# Optional overrides must point to destinations that do not already exist.
# export DEEPMS_PIPELINE_TRAIN_ROOT=/path/to/new/evaluation-specific/train/root
# export DEEPMS_ABLATION_INFERENCE_ROOT=/path/to/outputs/inference/diffusion_single_map
# export DEEPMS_PIPELINE_STATE_ROOT=/path/to/outputs/slurm/pipelines

# These are only needed when submitting individual component jobs manually.
# export DEEPMS_ABLATION_CHECKPOINT_ROOT=/path/to/completed/diffusion_single_map
# export DEEPMS_EVALUATION_MODE=dataset_calibrated
# export DEEPMS_EXPECTED_INFERENCE_RUNS=12
# export DEEPMS_INFERENCE_RUNS_ROOT=/path/to/one/completed/evaluation

# Optional private sidecar: columns m_id, include, label_override.
# export DEEPMS_REPORT_COHORT_OVERRIDES=/path/to/internal_report_overrides.csv
