# Shenlab site profile for the DeepMS Slurm ablation workflow.
#
# From the root of a fresh clone:
# cp configs/slurm.shenlab.env .env
# set -a
# source .env
# set +a
# sbatch scripts/slurm/ablation/run_diffusion_ablation_pipeline.sbatch
#
# Source this file from the repository root so PWD identifies this clone.

export DEEPMS_PROJECT_ROOT="$(pwd -P)"
export DEEPMS_UV_BIN="/gpfs/data/shenlab/Jiajian/software/miniconda3/bin/uv"

# Shared training inputs.
export DEEPMS_TRAIN_CSV="/gpfs/data/shenlab/Jiajian/MS_Project/code/ms-diagnosis/meta_data/updated_label_dataset/train_dataset_all_latest_1230_ADNI_updated.csv"
export DEEPMS_VAL_CSV="/gpfs/data/shenlab/Jiajian/MS_Project/code/ms-diagnosis/meta_data/updated_label_dataset/reg/validation_dataset_all_latest_updated.csv"
export DEEPMS_PRETRAINED_PATH="/gpfs/data/shenlab/Jiajian/MS_Project/code/ms-diagnosis/pretrain_weights/VoCo/VoComni_B.pt"

# Shared evaluation manifests.
export DEEPMS_INTERNAL_TEST_CSV="/gpfs/data/shenlab/Jiajian/MS_Project/code/ms-diagnosis/meta_data/updated_label_dataset/reg/test_dataset_all_latest_1006_updated.csv"
export DEEPMS_KRAKOW_TEST_CSV="/gpfs/data/shenlab/Jiajian/MS_Project/ms_data/external_dataset/MS_UJ_0109.csv"
export DEEPMS_PUBLIC_EXTERNAL_TEST_CSV="/gpfs/data/shenlab/Jiajian/MS_Project/ms_data/external_dataset/lesion_filling/0_filled_all_dil_3.csv"

# Existing reference checkpoint for manual single-profile inference only.
export DEEPMS_MODEL_PATH="/gpfs/data/shenlab/Jiajian/MS_Project/code/ms-diagnosis/output/VisualEncoder/dmri+smri/VoCo_Salient_2/VoCo_Salient_2_bet_only_2DT1_NCE_2DT1_CE_2DFLAIR_NCE_2DFLAIR_CE_3DT1_NCE_3DT1_CE_3DFLAIR_NCE_3DFLAIR_CE_b0_ad_dti_fa_dti_md_dti_rd_dti_Da_smi_DePar_smi_DePerp_smi_f_smi_p2_smi_ak_wdki_mk_wdki_rk_wdki_oversampling_lr0.0001_bs16_ep40/20250816_101031_1/best_model.pth"

# Original experiment strategy, now explicit and reproducible.
export DEEPMS_NUM_EPOCHS=40
export DEEPMS_EARLY_STOPPING_EPOCHS=5
export DEEPMS_VAL_INTERVAL=1
export DEEPMS_SAVE_INTERVAL=5
export DEEPMS_BATCH_SIZE=16
export DEEPMS_VAL_BATCH_SIZE=16
export DEEPMS_NUM_WORKERS=4
export DEEPMS_LEARNING_RATE=1e-4
export DEEPMS_MIN_LR=1e-6
export DEEPMS_GRADIENT_ACCUMULATION_STEPS=1
export DEEPMS_AUC_METRIC=micro
export DEEPMS_SEED=88
export DEEPMS_FOLD=1
export DEEPMS_MIXED_PRECISION=fp16
export DEEPMS_USE_WARMUP=0
export DEEPMS_INCLUDE_B0=1

# Inference and reporting policy.
export DEEPMS_SAVE_VISUALIZATIONS=0
export DEEPMS_USE_CIS=0
export DEEPMS_REPORT_BOOTSTRAPS=2000
export DEEPMS_REPORT_SEED=42
export DEEPMS_REPORT_THRESHOLD=0.5
export DEEPMS_REPORT_TARGET_FPR=0.01

# Complete Public External workflow: calibrated evaluation plus raw masking pair.
export DEEPMS_PIPELINE_MODE=both
export DEEPMS_ABLATION_INFER_PROFILE=public_external_unmasked
export DEEPMS_ABLATION_CONCURRENCY=4
export DEEPMS_ABLATION_EVAL_ID="${DEEPMS_ABLATION_EVAL_ID:-public-external-ablation-$(date +%Y%m%d-%H%M%S)}"

export DEEPMS_PIPELINE_TRAIN_ROOT="${DEEPMS_PROJECT_ROOT}/outputs/train/diffusion_single_map/${DEEPMS_ABLATION_EVAL_ID}"
export DEEPMS_ABLATION_INFERENCE_ROOT="${DEEPMS_PROJECT_ROOT}/outputs/inference/diffusion_single_map"
export DEEPMS_PIPELINE_STATE_ROOT="${DEEPMS_PROJECT_ROOT}/outputs/slurm/pipelines"

# Optional Internal-only sidecar; leave disabled for the Public External pipeline.
# export DEEPMS_REPORT_COHORT_OVERRIDES="/gpfs/data/shenlab/Jiajian/MS_Project/code/DeepMS/.local/internal_report_overrides.csv"
